      "cell_type": "code",
      "source": [
        "\n",
        "# STEP 5: Run Flan-T5 on All Test Cases\n",
        "#\n",
        "# For each test case we:\n",
        "# 1. Give the model the document + question\n",
        "# 2. Get its answer\n",
        "# 3. Check if it matches the contextual answer (used document)\n",
        "#    or the parametric answer (used its own memory)\n",
        "#\n",
        "# This tells us: does the model trust the document or itself?\n",
        "\n",
        "\n",
        "def ask_model(context, question, max_new_tokens=50):\n",
        "    \"\"\"\n",
        "    Ask Flan-T5 a question given a context document.\n",
        "    Returns the model's raw answer as a string.\n",
        "    \"\"\"\n",
        "    # Format the prompt — instruction style works best for Flan-T5\n",
        "    prompt = f\"\"\"Read the following document carefully and answer\n",
        "the question based ONLY on what the document says.\n",
        "\n",
        "Document: {context}\n",
        "\n",
        "Question: {question}\n",
        "\n",
        "Answer:\"\"\"\n",
        "\n",
        "    inputs = tokenizer(\n",
        "        prompt,\n",
        "        return_tensors='pt',\n",
        "        truncation=True,\n",
        "        max_length=512\n",
        "    ).to(device)\n",
        "\n",
        "    outputs = model.generate(\n",
        "        **inputs,\n",
        "        max_new_tokens=max_new_tokens,\n",
        "        num_beams=4,\n",
        "        early_stopping=True\n",
        "    )\n",
        "\n",
        "    answer = tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
        "    return answer.strip().lower()\n",
        "\n",
        "def classify_answer(model_answer, contextual_answer, parametric_answer):\n",
        "    \"\"\"\n",
        "    Classify whether the model used:\n",
        "    - contextual knowledge (trusted the document)\n",
        "    - parametric knowledge (trusted its own memory)\n",
        "    - neither (unclear answer)\n",
        "    \"\"\"\n",
        "    model_answer = model_answer.lower()\n",
        "    contextual_answer = contextual_answer.lower()\n",
        "    parametric_answer = parametric_answer.lower()\n",
        "\n",
        "    # Check if contextual answer appears in model's response\n",
        "    if any(word in model_answer for word in contextual_answer.split()):\n",
        "        return 'contextual'\n",
        "    # Check if parametric answer appears in model's response\n",
        "    elif any(word in model_answer for word in parametric_answer.split()):\n",
        "        return 'parametric'\n",
        "    else:\n",
        "        return 'neither'\n",
        "\n",
        "# Run model on all test cases\n",
        "print(\"Running model on all test cases...\")\n",
        "results = []\n",
        "\n",
        "for i, row in df.iterrows():\n",
        "    answer = ask_model(row['context'], row['question'])\n",
        "    knowledge_type = classify_answer(\n",
        "        answer,\n",
        "        row['contextual_answer'],\n",
        "        row['parametric_answer']\n",
        "    )\n",
        "    results.append({\n",
        "        'question':           row['question'],\n",
        "        'model_answer':       answer,\n",
        "        'contextual_answer':  row['contextual_answer'],\n",
        "        'parametric_answer':  row['parametric_answer'],\n",
        "        'knowledge_used':     knowledge_type,\n",
        "        'category':           row['category'],\n",
        "        'doc_length':         row['doc_length'],\n",
        "        'fact_position':      row['fact_position'],\n",
        "    })\n",
        "    print(f\"  [{i+1}/16] {knowledge_type.upper():12} | Q: {row['question'][:50]}...\")\n",
        "\n",
        "results_df = pd.DataFrame(results)\n",
        "print(\"\\n Done!\")"
      ],
