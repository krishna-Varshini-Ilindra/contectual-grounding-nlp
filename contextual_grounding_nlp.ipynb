    {
      "cell_type": "code",
      "source": [
        "# STEP 3: Load Flan-T5 Model\n",
        "# Flan-T5 is Google's instruction-following model\n",
        "# It can answer questions both from:\n",
        "#  1. Agiven document (Contextual Knowledge)\n",
        "#  2. Its own training memory (Parametric Knowledge)\n",
        "# Our experiment: give it a document with a WRONG answer\n",
        "# and see if it trusts the document or its own memory\n",
        "# If it uses its ,memory istead of the document -> that's the \"context ignorance\" problem Dr. Agarwal studies.\n",
        "\n",
        "print(\"Loading Flan-T5... (~1 min)\")\n",
        "\n",
        "model_name = 'google/flan-t5-large'\n",
        "tokenizer = T5Tokenizer.from_pretrained(model_name)\n",
        "model = T5ForConditionalGeneration.from_pretrained(model_name).to(device)\n",
        "\n",
        "print(\"Model loaded!\")"
      ],
